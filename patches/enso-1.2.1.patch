+  ntype.declare = file_ns::node_declare;
+  ntype.draw_buttons = file_ns::node_buts;
+  ntype.initfunc = file_ns::node_init;
+  bke::node_type_storage(
+      ntype, "NodeShaderOutputAOV", node_free_standard_storage, node_copy_standard_storage);
+  ntype.gpu_fn = file_ns::node_gpu;
+  ntype.default_width = 160.0f;
+  bke::node_register_type(ntype);
+}
+
+/* -------------------------------------------------------------------- Ensō AOV Input */
+namespace nodes::node_shader_enso_aov_input_cc {
+
+static void node_declare(NodeDeclarationBuilder &b)
+{
+  b.add_input<decl::Vector>("Offset"_ustr)
+      .default_value({0.0f, 0.0f, 0.0f})
+      .description("Read the pass this many pixels to the side (X, Y), for example to push a "
+                   "shadow or a line away from the shape that made it");
+  b.add_output<decl::Color>("Color"_ustr).description("Colour of the pass behind this surface");
+  b.add_output<decl::Float>("Value"_ustr).description(
+      "Value of the pass behind this surface (the average for a colour pass)");
+  b.add_output<decl::Float>("Alpha"_ustr);
+}
+
+static void node_buts(ui::Layout &layout, bContext * /*C*/, PointerRNA *ptr)
+{
+  layout.prop(ptr, "aov_name", ui::ITEM_R_SPLIT_EMPTY_NAME, "", ICON_RENDERLAYERS);
+}
+
+static void node_init(bNodeTree * /*ntree*/, bNode *node)
+{
+  NodeShaderOutputAOV *aov = MEM_new<NodeShaderOutputAOV>("Enso AOV Input");
+  node->storage = aov;
+}
+
+static int node_gpu(GPUMaterial *mat,
+                    bNode *node,
+                    bNodeExecData * /*execdata*/,
+                    GPUNodeStack *in,
+                    GPUNodeStack *out)
+{
+  const NodeShaderOutputAOV *aov = static_cast<const NodeShaderOutputAOV *>(node->storage);
+  const char *name = aov ? aov->name : "";
+  uint hash = BLI_hash_string(name);
+  /* The pass images have to be there for this material, and the viewport has to keep this
+   * pass even when nothing else shows it. */
+  GPU_material_flag_set(mat, GPU_MATFLAG_AOV);
+  GPU_enso_aov_input_tag(name);
+  return GPU_stack_link(mat,
+                        node,
+                        "node_enso_aov_input",
+                        in,
+                        out,
+                        GPU_constant(reinterpret_cast<float *>(&hash)),
+                        GPU_kernel_globals(),
+                        GPU_shading_data());
+}
+
+}  // namespace nodes::node_shader_enso_aov_input_cc
+
+void register_node_type_sh_enso_aov_input()
+{
+  namespace file_ns = nodes::node_shader_enso_aov_input_cc;
+  static bke::bNodeType ntype;
+  sh_node_type_base(&ntype, "ShaderNodeEnsoAOVInput"_ustr);
+  ntype.ui_name = "Ensō AOV Input";
+  ntype.ui_description =
+      "Read a render pass inside a material: what the surfaces behind this one wrote into an "
+      "AOV, an Ensō Tag or an Ensō pass. Made for Blended materials, which are drawn after "
+      "everything solid: a shadow or glass layer can pick up the mask or colour of the face "
+      "behind it and use it as a factor. The pass must exist in the view layer (EEVEE)";
+  ntype.nclass = NODE_CLASS_INPUT;
+  ntype.declare = file_ns::node_declare;
+  ntype.draw_buttons = file_ns::node_buts;
+  ntype.initfunc = file_ns::node_init;
+  bke::node_type_storage(
+      ntype, "NodeShaderOutputAOV", node_free_standard_storage, node_copy_standard_storage);
+  ntype.gpu_fn = file_ns::node_gpu;
+  ntype.default_width = 160.0f;
+  bke::node_register_type(ntype);
+}
+
+namespace nodes::node_shader_enso_marked_lines_cc {
+
+static void node_declare(NodeDeclarationBuilder &b)
+{
+  b.add_input<decl::Float>("Width"_ustr)
+      .default_value(1.5f)
+      .min(0.0f)
+      .max(32.0f)
+      .description("Width of the line in screen pixels");
+  b.add_output<decl::Float>("Line"_ustr)
+      .description("1 on the marked edges of the mesh. It also goes to the Enso Marked Lines "
+                   "pass, for the Ensō Outline node of the compositor");
+}
+
+static int node_gpu(GPUMaterial *mat,
+                    bNode * /*node*/,
+                    bNodeExecData * /*execdata*/,
+                    GPUNodeStack *in,
+                    GPUNodeStack *out)
+{
+  /* Written by the "Ensō Marked Lines" modifier from the chosen vertex groups. */
+  GPUNodeLink *marked = GPU_attribute(mat, CD_AUTO_FROM_NAME, "enso_marked");
+  /* The pass is written whether or not the node is connected to anything. */
+  const bool ok = true;
+  GPUNodeLink *line = nullptr;
+  GPU_link(mat,
+           "node_enso_marked_lines",
+           in[0].link ? in[0].link : GPU_uniform(in[0]),
+           marked,
+           &line);
+  out[0].link = line;
+  if (ok && line) {
+    uint hash = BLI_hash_string("Enso Marked Lines");
+    GPUNodeLink *outlink = nullptr;
+    GPU_material_flag_set(mat, GPU_MATFLAG_AOV | GPU_MATFLAG_OBJECT_INFO);
+    GPU_link(mat,
+             "node_output_aov",
+             line,
+             line,
+             GPU_constant(reinterpret_cast<float *>(&hash)),
+             GPU_kernel_globals(),
+             GPU_shading_data(),
+             &outlink);
+    if (outlink) {
+      GPU_material_add_output_link_aov(mat, outlink, hash);
+    }
+  }
+  return ok;
+}
+
+}  // namespace nodes::node_shader_enso_marked_lines_cc
+
+void register_node_type_sh_enso_marked_lines()
+{
+  namespace file_ns = nodes::node_shader_enso_marked_lines_cc;
+  static bke::bNodeType ntype;
+  sh_node_type_base(&ntype, "ShaderNodeEnsoMarkedLines"_ustr);
+  ntype.ui_name = "Ensō Marked Lines";
+  ntype.ui_description =
+      "Lines along the edges you marked with vertex groups, at a fixed width in pixels. Set "
+      "the groups up from the Ensō Outline node of the compositor (EEVEE)";
+  ntype.nclass = NODE_CLASS_INPUT;
+  ntype.declare = file_ns::node_declare;
+  ntype.gpu_fn = file_ns::node_gpu;
+  ntype.default_width = 160.0f;
+  bke::node_register_type(ntype);
+}
