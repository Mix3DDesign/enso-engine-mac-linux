+static void node_init(bNodeTree * /*ntree*/, bNode *node)
+{
+  NodeShaderOutputAOV *tag = MEM_new<NodeShaderOutputAOV>("Enso Tag");
+  STRNCPY(tag->name, "Tag");
+  node->storage = tag;
+}
+
+static int node_gpu(GPUMaterial *mat,
+                    bNode *node,
+                    bNodeExecData * /*execdata*/,
+                    GPUNodeStack *in,
+                    GPUNodeStack *out)
+{
+  /* The passes are written whether or not the node is connected to anything, so the values are
+   * worked out here and handed to the outputs, instead of leaving it to the node stack (which
+   * only makes the outputs something is connected to). */
+  const bool ok = true;
+  GPUNodeLink *tag_mask = nullptr;
+  GPUNodeLink *tag_color = nullptr;
+  GPU_link(mat,
+           "node_enso_tag",
+           in[0].link ? in[0].link : GPU_uniform(in[0]),
+           in[1].link ? in[1].link : GPU_uniform(in[1]),
+           &tag_mask,
+           &tag_color);
+  out[0].link = tag_mask;
+  out[1].link = tag_color;
+  if (ok && tag_mask && tag_color) {
+    const NodeShaderOutputAOV *tag = static_cast<const NodeShaderOutputAOV *>(node->storage);
+    /* The pass named like the tag is its mask, the shared pass shows every tag in its colour. */
+    const char *names[2] = {tag ? tag->name : "", "Enso Tags"};
+    for (const char *name : names) {
+      if (name[0] == '\0') {
+        continue;
+      }
+      uint hash = BLI_hash_string(name);
+      GPUNodeLink *outlink = nullptr;
+      GPU_material_flag_set(mat, GPU_MATFLAG_AOV | GPU_MATFLAG_OBJECT_INFO);
+      GPU_link(mat,
+               "node_output_aov",
+               tag_color,
+               tag_mask,
+               GPU_constant(reinterpret_cast<float *>(&hash)),
+               GPU_kernel_globals(),
+               GPU_shading_data(),
+               &outlink);
+      if (outlink) {
+        GPU_material_add_output_link_aov(mat, outlink, hash);
+      }
+    }
+  }
+  return ok;
+}
