index de26d236cf6..ab6a89ebba5 100644
--- a/scripts/startup/bl_operators/enso_passes.py
+++ b/scripts/startup/bl_operators/enso_passes.py
@@ -123,7 +123,276 @@ class VIEWLAYER_PT_enso_passes(Panel):
             r.label(text=source)
 
 
+# ---------------------------------------------------------------------------------------------
+# Ensō Tag: every tag name is a render pass. The passes are turned on by themselves, so a tag
+# shows up on the Render Layers node as soon as the node is in a material.
+
+TAGS_PASS = "Enso Tags"
+
+
+def tag_names():
+    """Names of all Ensō Tag nodes in the file."""
+    names = []
+    trees = [m.node_tree for m in bpy.data.materials if m.node_tree]
+    trees += [g for g in bpy.data.node_groups if g.bl_idname == 'ShaderNodeTree']
+    for tree in trees:
+        for node in tree.nodes:
+            if node.bl_idname == "ShaderNodeEnsoTag":
+                name = node.tag_name.strip()
+                if name and name not in names:
+                    names.append(name)
+    return names
+
+
+def aov_input_passes():
+    """The passes that Ensō AOV Input nodes read and that an AOV Output node writes, with the kind
+    of pass each one needs. A pass that only carries a value becomes a value pass."""
+    wanted, written = [], {}
+    trees = [m.node_tree for m in bpy.data.materials if m.node_tree]
+    trees += [g for g in bpy.data.node_groups if g.bl_idname == 'ShaderNodeTree']
+    for tree in trees:
+        for node in tree.nodes:
+            if node.bl_idname == "ShaderNodeEnsoAOVInput":
+                name = node.aov_name.strip()
+                if name and name not in wanted:
+                    wanted.append(name)
+            elif node.bl_idname == "ShaderNodeOutputAOV":
+                name = node.aov_name.strip()
+                if not name:
+                    continue
+                color = node.inputs.get("Color")
+                value = node.inputs.get("Value")
+                has_color = color is not None and (color.is_linked or tuple(color.default_value)[:3] != (0.0, 0.0, 0.0))
+                has_value = value is not None and (value.is_linked or value.default_value != 0.0)
+                kind = 'VALUE' if (has_value and not has_color) else 'COLOR'
+                if written.get(name) != 'COLOR':
+                    written[name] = kind
+    return [(name, written[name]) for name in wanted if name in written]
+
+
+def sync_tag_passes():
+    names = tag_names()
+    passes = []
+    if names:
+        passes = [(TAGS_PASS, 'COLOR')] + [(n, 'VALUE') for n in names]
+    try:
+        passes += [p for p in aov_input_passes() if p[0] not in {q[0] for q in passes}]
+    except Exception:
+        pass
+    if not passes:
+        return None
+    for scene in bpy.data.scenes:
+        for vl in scene.view_layers:
+            for name, kind in passes:
+                if not _has(vl, name):
+                    aov = vl.aovs.add()
+                    aov.name = name
+                    aov.type = kind
+    return None
+
+
+_tag_sync_pending = False
+
+
+def _tag_sync_timer():
+    global _tag_sync_pending
+    _tag_sync_pending = False
+    try:
+        sync_tag_passes()
+    except Exception:
+        pass
+    return None
+
+
+@bpy.app.handlers.persistent
+def _enso_tag_handler(scene, depsgraph=None):
+    global _tag_sync_pending
+    if _tag_sync_pending:
+        return
+    if depsgraph is not None:
+        try:
+            if not (depsgraph.id_type_updated('MATERIAL') or depsgraph.id_type_updated('NODETREE')):
+                return
+        except Exception:
+            return
+    _tag_sync_pending = True
+    bpy.app.timers.register(_tag_sync_timer, first_interval=0.2)
+
+
+@bpy.app.handlers.persistent
+def _enso_tag_load(_file=None):
+    bpy.app.timers.register(_tag_sync_timer, first_interval=0.5)
+
+
+for _h, _f in ((bpy.app.handlers.depsgraph_update_post, _enso_tag_handler),
+               (bpy.app.handlers.load_post, _enso_tag_load),
+               (bpy.app.handlers.render_init, _enso_tag_load)):
+    if not any(getattr(f, "__name__", "") == _f.__name__ for f in _h):
+        _h.append(_f)
+
+
+# ---------------------------------------------------------------------------------------------
+# Marked lines: edges marked with vertex groups get a line in the Ensō Outline compositor node.
+# The vertex groups are not visible to the renderer, so a small modifier copies them into a mesh
+# attribute, a node in the materials draws the line from it into a pass, and the pass is
+# connected to the Outline node.
+
+MARKED_PASS = "Enso Marked Lines"
+MARKED_GROUP = "Ensō Marked Lines"
+MARKED_SLOTS = 8
+
+
+def _marked_node_group():
+    group = bpy.data.node_groups.get(MARKED_GROUP)
+    if group is not None and group.bl_idname == 'GeometryNodeTree' and group.get("enso_marked") == 2:
+        return group
+    if group is None or group.bl_idname != 'GeometryNodeTree':
+        group = bpy.data.node_groups.new(MARKED_GROUP, 'GeometryNodeTree')
+    group.nodes.clear()
+    group.interface.clear()
+    group["enso_marked"] = 2
+    group.is_modifier = True
+    it = group.interface
+    it.new_socket("Geometry", in_out='INPUT', socket_type='NodeSocketGeometry')
+    it.new_socket("Geometry", in_out='OUTPUT', socket_type='NodeSocketGeometry')
+    for i in range(MARKED_SLOTS):
+        it.new_socket("Group %d" % (i + 1), in_out='INPUT', socket_type='NodeSocketString')
+    nodes, links = group.nodes, group.links
+    gin = nodes.new('NodeGroupInput')
+    gin.location = (-600, 0)
+    gout = nodes.new('NodeGroupOutput')
+    gout.location = (600, 0)
+    value = None
+    for i in range(MARKED_SLOTS):
+        attr = nodes.new('GeometryNodeInputNamedAttribute')
+        attr.data_type = 'FLOAT'
+        attr.location = (-380, -i * 140)
+        links.new(gin.outputs["Group %d" % (i + 1)], attr.inputs["Name"])
+        if value is None:
+            value = attr.outputs["Attribute"]
+        else:
+            mx = nodes.new('ShaderNodeMath')
+            mx.operation = 'MAXIMUM'
+            mx.location = (-160 + i * 20, -i * 140)
+            links.new(value, mx.inputs[0])
+            links.new(attr.outputs["Attribute"], mx.inputs[1])
+            value = mx.outputs[0]
+    store = nodes.new('GeometryNodeStoreNamedAttribute')
+    store.data_type = 'FLOAT'
+    store.domain = 'POINT'
+    store.location = (360, 0)
+    store.inputs["Name"].default_value = "enso_marked"
+    links.new(gin.outputs["Geometry"], store.inputs["Geometry"])
+    links.new(value, store.inputs["Value"])
+    links.new(store.outputs["Geometry"], gout.inputs["Geometry"])
+    return group
+
+
+def _set_modifier_input(mod, identifier, value):
+    try:
+        mod[identifier] = value
+        return
+    except Exception:
+        pass
+    try:
+        getattr(mod.properties.inputs, identifier).value = value
+    except Exception:
+        pass
+
+
+class NODE_OT_enso_marked_lines_setup(Operator):
+    """Draw lines on the edges of chosen vertex groups. Put the vertices of an edge loop in a """ \
+        """vertex group, type the group names here, and the lines appear in the Ensō Outline """ \
+        """node. Run it again after adding groups or objects"""
+    bl_idname = "node.enso_marked_lines_setup"
+    bl_label = "Marked Lines Setup"
+    bl_options = {'REGISTER', 'UNDO'}
+
+    groups: bpy.props.StringProperty(
+        name="Vertex Groups",
+        description="Names of the vertex groups to draw, separated by commas (up to 8)")
+    width: bpy.props.FloatProperty(
+        name="Width", default=1.5, min=0.1, max=32.0,
+        description="Width of the lines in pixels")
+
+    def invoke(self, context, _event):
+        scene = context.scene
+        if not self.groups:
+            self.groups = scene.get("enso_marked_groups", "")
+        if not self.groups:
+            # Offer the vertex groups of the active object.
+            ob = context.view_layer.objects.active
+            if ob is not None and ob.type == 'MESH':
+                self.groups = ", ".join(g.name for g in ob.vertex_groups[:MARKED_SLOTS])
+        return context.window_manager.invoke_props_dialog(self, width=360)
+
+    def execute(self, context):
+        scene = context.scene
+        names = [n.strip() for n in self.groups.split(",") if n.strip()][:MARKED_SLOTS]
+        if not names:
+            self.report({'ERROR'}, "Type at least one vertex group name")
+            return {'CANCELLED'}
+        scene["enso_marked_groups"] = ", ".join(names)
+        group = _marked_node_group()
+        idents = [s.identifier for s in group.interface.items_tree
+                  if getattr(s, "in_out", "") == 'INPUT' and s.socket_type == 'NodeSocketString']
+        n_objects = 0
+        for ob in scene.objects:
+            if ob.type != 'MESH' or not any(n in ob.vertex_groups for n in names):
+                continue
+            mod = next((m for m in ob.modifiers
+                        if m.type == 'NODES' and m.node_group == group), None)
+            if mod is None:
+                mod = ob.modifiers.new(MARKED_GROUP, 'NODES')
+                mod.node_group = group
+            for i, ident in enumerate(idents):
+                _set_modifier_input(mod, ident, names[i] if i < len(names) else "")
+            ob.update_tag()
+            n_objects += 1
+            for slot in ob.material_slots:
+                mat = slot.material
+                if mat is None or mat.node_tree is None:
+                    continue
+                node = next((n for n in mat.node_tree.nodes
+                             if n.bl_idname == "ShaderNodeEnsoMarkedLines"), None)
+                if node is None:
+                    node = mat.node_tree.nodes.new("ShaderNodeEnsoMarkedLines")
+                    xs = [n.location.x for n in mat.node_tree.nodes if n != node] or [0.0]
+                    ys = [n.location.y for n in mat.node_tree.nodes if n != node] or [0.0]
+                    node.location = (min(xs), min(ys) - 220.0)
+                node.inputs["Width"].default_value = self.width
+        if n_objects == 0:
+            self.report({'WARNING'}, "No mesh in this scene has a vertex group with one of these names")
+            return {'CANCELLED'}
+        for vl in scene.view_layers:
+            if not _has(vl, MARKED_PASS):
+                aov = vl.aovs.add()
+                aov.name = MARKED_PASS
+                aov.type = 'VALUE'
+        scene_name = scene.name
+
+        def connect():
+            sc = bpy.data.scenes.get(scene_name)
+            tree = getattr(sc, "compositing_node_group", None) if sc else None
+            if tree is None:
+                return None
+            layers = next((n for n in tree.nodes if n.bl_idname == "CompositorNodeRLayers"), None)
+            if layers is None or MARKED_PASS not in layers.outputs:
+                return None
+            for node in tree.nodes:
+                if node.bl_idname == "CompositorNodeEnsoOutline":
+                    sock = node.inputs.get("Marked Lines")
+                    if sock is not None and not sock.is_linked:
+                        tree.links.new(layers.outputs[MARKED_PASS], sock)
+            return None
+
+        bpy.app.timers.register(connect, first_interval=0.3)
+        self.report({'INFO'}, "Marked lines set up on %d objects" % n_objects)
+        return {'FINISHED'}
+
+
 classes = (
+    NODE_OT_enso_marked_lines_setup,
     SCENE_OT_enso_passes_add,
     SCENE_OT_enso_passes_remove,
     VIEWLAYER_PT_enso_passes,
