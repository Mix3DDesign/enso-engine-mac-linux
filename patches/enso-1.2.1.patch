+def _tri_dist(px, py, tri):
+    """Signed distance to the edges of a triangle: positive inside."""
+    np = _np()
+    (ax, ay), (bx, by), (cx, cy) = tri
+    area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
+    sgn = 1.0 if area > 0 else -1.0
+    dist = None
+    for (x0, y0), (x1, y1) in (((ax, ay), (bx, by)), ((bx, by), (cx, cy)), ((cx, cy), (ax, ay))):
+        ex, ey = x1 - x0, y1 - y0
+        ln = max(math.hypot(ex, ey), 1e-9)
+        dd = sgn * (ex * (py - y0) - ey * (px - x0)) / ln
+        dist = dd if dist is None else np.minimum(dist, dd)
+    return dist
+
