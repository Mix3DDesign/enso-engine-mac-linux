+/* Ensō AOV Input: the names of the passes that materials read. The viewport only keeps the AOVs
+ * that something shows, so the renderer asks here which ones it has to keep as well. */
+static std::mutex enso_aov_input_mutex;
+static blender::Set<std::string> &enso_aov_input_names()
+{
+  static blender::Set<std::string> names;
+  return names;
+}
+
+void GPU_enso_aov_input_tag(const char *name)
+{
+  if (name == nullptr || name[0] == '\0') {
+    return;
+  }
+  std::scoped_lock lock(enso_aov_input_mutex);
+  enso_aov_input_names().add(name);
+}
+
+bool GPU_enso_aov_input_used(const char *name)
+{
+  if (name == nullptr || name[0] == '\0') {
+    return false;
+  }
+  std::scoped_lock lock(enso_aov_input_mutex);
+  return enso_aov_input_names().contains(name);
+}
