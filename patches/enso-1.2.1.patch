+/* The light chosen in an Ensō Light Select node, as shader links: the same function the node
+ * itself runs, so another node can read the light's shadow without a second wire. Returns false
+ * when `node` is not a Light Select node. */
+static bool enso_light_select_shadow_link(GPUMaterial *mat, const bNode *node, GPUNodeLink **r_shadow)
+{
+  if (node == nullptr || !STREQ(node->idname, "ShaderNodeEnsoLightSelect")) {
+    return false;
+  }
+  Object *ob = reinterpret_cast<Object *>(node->id);
+  float no_matrix[4][4] = {};
+  float white[3] = {1.0f, 1.0f, 1.0f};
+  float power = 0.0f;
+  float is_sun = 0.0f;
+  if (ob && ob->type == OB_LAMP && ob->data) {
+    const Light *la = id_cast<Light *>(ob->data);
+    white[0] = la->r;
+    white[1] = la->g;
+    white[2] = la->b;
+    power = la->energy;
+    is_sun = (la->type == LA_SUN) ? 1.0f : 0.0f;
+  }
+  else if (ob) {
+    power = 1.0f;
+  }
+  if (ob && ob->base_flag != 0) {
+    const int needed = G.is_rendering ? BASE_ENABLED_RENDER :
+                                        BASE_ENABLED_AND_VISIBLE_IN_DEFAULT_VIEWPORT;
+    if ((ob->base_flag & needed) == 0) {
+      power = 0.0f;
+    }
+  }
+  GPUNodeLink *matrix = ob ? GPU_uniform(&ob->object_to_world()[0][0]) :
+                             GPU_uniform(&no_matrix[0][0]);
+  GPU_material_flag_set(mat, GPU_MATFLAG_LIGHTING);
+  GPUNodeLink *direction = nullptr, *color = nullptr, *strength = nullptr, *position = nullptr,
+              *distance = nullptr;
+  GPU_link(mat,
+           "node_enso_light_select",
+           matrix,
+           GPU_uniform(white),
+           GPU_uniform(&power),
+           GPU_uniform(&is_sun),
+           GPU_kernel_globals(),
+           GPU_shading_data(),
+           &direction,
+           &color,
+           &strength,
+           &position,
+           &distance,
+           r_shadow);
+  return *r_shadow != nullptr;
+}
+
+/* The node at the other end of an input's wire, when the wire is on. */
+static const bNode *enso_input_source(const bNode *node, const int index)
+{
+  const bNodeSocket *sock = static_cast<const bNodeSocket *>(BLI_findlink(&node->inputs, index));
+  if (sock == nullptr || sock->link == nullptr || (sock->link->flag & NODE_LINK_MUTED)) {
+    return nullptr;
+  }
+  return sock->link->fromnode;
+}
