+def _tri_inradius(tri):
+    (ax, ay), (bx, by), (cx, cy) = tri
+    a = math.hypot(bx - cx, by - cy)
+    b = math.hypot(ax - cx, ay - cy)
+    c = math.hypot(ax - bx, ay - by)
+    area = abs((bx - ax) * (cy - ay) - (by - ay) * (cx - ax)) * 0.5
+    return 2.0 * area / max(a + b + c, 1e-9)
