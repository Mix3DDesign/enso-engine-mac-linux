+/* Ensō Shade Info with nothing connected: the main light of the scene (the first sun, or the
+ * first other light when there is no sun), the direction toward it and how much of it reaches the
+ * point according to its own shadow maps. */
+void enso_main_light(KernelGlobals &kg,
+                     const ShadingData &sd,
+                     float3 position,
+                     float3 &direction,
+                     float &visibility,
+                     float &found)
+{
+  direction = float3(0.0f, 0.0f, 1.0f);
+  visibility = 1.0f;
+  found = 0.0f;
+  if (kg.pipe.use_lighting_nodes) [[static_branch]] {
+#if (defined(GPU_FRAGMENT_SHADER) && defined(SRT_CONSTANT_use_lighting_nodes)) || \
+    defined(GLSL_CPP_STUBS)
+    eevee::light::VisibleLightIterator iter;
+    light_iter_init(kg, sd, iter);
+    float best = 0.0f;
+    while (light_iter_next(kg, iter)) {
+      if (light_iter_should_skip(kg, iter, sd.P)) {
+        continue;
+      }
+      int light_index = iter.index_get();
+      LightData light = kg.lrd.light_buf[light_index];
+      bool sun = is_sun_light(light.type);
+      float score = sun ? 2.0f : 1.0f;
+      if (score <= best) {
+        continue;
+      }
+      best = score;
+      ObjectMatrices light_object = kg.light_matrices_get(light_index);
+      /* A sun shines along its own -Z, so the light comes from +Z. */
+      float3 to_light = sun ? light_object.model[2].xyz : light_object.model[3].xyz - position;
+      float len = length(to_light);
+      if (len > 1e-6f) {
+        direction = to_light / len;
+      }
+      float4 shadow_color;
+      enso_shadow_eval_impl(kg, sd, light_index, position, shadow_color);
+      visibility = shadow_color.r;
+      found = 1.0f;
+    }
+#endif
+  }
+}
