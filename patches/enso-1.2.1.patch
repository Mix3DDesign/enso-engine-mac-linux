diff --git a/scripts/startup/bl_operators/enso_painted.py b/scripts/startup/bl_operators/enso_painted.py
new file mode 100644
index 00000000000..b0b2aa48494
--- /dev/null
+++ b/scripts/startup/bl_operators/enso_painted.py
@@ -0,0 +1,146 @@
+# SPDX-FileCopyrightText: 2026 Mix 3D Design
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+"""Ensō Painted Strokes: a painted brush texture that breaks the edge of a cel shadow into strokes.
+
+Cel shading draws the line between light and shadow as one clean curve. A painter does not:
+the edge is made of brush marks. This adds a node group that lays a tiling texture of painted
+strokes over the object and turns it into a moving threshold. Plug its Threshold output into
+the Threshold of Ensō Cel Bands and the shadow edge follows the strokes.
+
+The texture ships with Ensō (enso_painted_strokes.png). Any other grey tiling image can be
+dropped into the Image node inside the group.
+"""
+
+import os
+
+import bpy
+from bpy.types import Operator
+
+GROUP = "Ensō Painted Strokes"
+IMAGE = "enso_painted_strokes.png"
+VERSION = 1
+
+
+def texture_path():
+    for kind in ('LOCAL', 'SYSTEM', 'USER'):
+        base = bpy.utils.resource_path(kind)
+        if not base:
+            continue
+        path = os.path.join(base, "scripts", "presets", "enso_textures", IMAGE)
+        if os.path.exists(path):
+            return path
+    return ""
+
+
+def ensure_image():
+    image = bpy.data.images.get(IMAGE)
+    if image is None:
+        path = texture_path()
+        if not path:
+            return None
+        image = bpy.data.images.load(path, check_existing=True)
+        image.name = IMAGE
+    try:
+        image.colorspace_settings.name = 'Non-Color'
+    except TypeError:
+        pass
+    return image
+
+
+def ensure_group():
+    group = bpy.data.node_groups.get(GROUP)
+    if group is not None and group.get("enso_version") == VERSION:
+        return group
+    group = bpy.data.node_groups.new(GROUP, "ShaderNodeTree")
+    iface = group.interface
+
+    def socket(name, kind, in_out, default=None, lo=None, hi=None, description=""):
+        s = iface.new_socket(name=name, in_out=in_out, socket_type=kind)
+        if default is not None:
+            s.default_value = default
+        if lo is not None:
+            s.min_value, s.max_value = lo, hi
+        if description:
+            s.description = description
+        return s
+
+    socket("Scale", "NodeSocketFloat", 'INPUT', 1.0, 0.01, 100.0, "Size of the strokes on the object. Higher is smaller")
+    socket("Strength", "NodeSocketFloat", 'INPUT', 0.9, 0.0, 4.0, "How far the strokes push the shadow edge")
+    socket("Threshold", "NodeSocketFloat", 'INPUT', 0.15, -1.0, 1.0, "Where the shadow starts, as on Ensō Cel Bands")
+    socket("Blend", "NodeSocketFloat", 'INPUT', 0.25, 0.0, 1.0, "Softens the seams where the texture meets itself around the object")
+    socket("Threshold", "NodeSocketFloat", 'OUTPUT', description="Connect to the Threshold of Ensō Cel Bands")
+    socket("Strokes", "NodeSocketFloat", 'OUTPUT', description="The stroke texture itself, 0 to 1")
+    socket("Normal", "NodeSocketVector", 'OUTPUT', description="The strokes as a light relief, for a Normal input")
+
+    nodes, links = group.nodes, group.links
+    n_in = nodes.new("NodeGroupInput"); n_in.location = (-900, 0)
+    n_out = nodes.new("NodeGroupOutput"); n_out.location = (500, 0)
+    coord = nodes.new("ShaderNodeTexCoord"); coord.location = (-900, 260)
+    scale = nodes.new("ShaderNodeVectorMath"); scale.operation = 'SCALE'; scale.location = (-680, 220)
+    image = nodes.new("ShaderNodeTexImage"); image.location = (-480, 240)
+    image.projection = 'BOX'
+    image.image = ensure_image()
+    image.label = "Strokes (any grey tiling image)"
+    centre = nodes.new("ShaderNodeMath"); centre.operation = 'SUBTRACT'; centre.location = (-160, 200)
+    centre.inputs[1].default_value = 0.5
+    push = nodes.new("ShaderNodeMath"); push.operation = 'MULTIPLY_ADD'; push.location = (60, 160)
+    bump = nodes.new("ShaderNodeBump"); bump.location = (60, -80)
+    bump.inputs["Distance"].default_value = 0.05
+    links.new(coord.outputs["Object"], scale.inputs[0])
+    links.new(n_in.outputs["Scale"], scale.inputs["Scale"])
+    links.new(scale.outputs["Vector"], image.inputs["Vector"])
+    try:
+        links.new(n_in.outputs["Blend"], image.inputs["Blend"])
+    except (KeyError, RuntimeError):
+        image.projection_blend = 0.25
+    links.new(image.outputs["Color"], centre.inputs[0])
+    links.new(centre.outputs[0], push.inputs[0])
+    links.new(n_in.outputs["Strength"], push.inputs[1])
+    links.new(n_in.outputs[2], push.inputs[2])
+    links.new(push.outputs[0], n_out.inputs[0])
+    links.new(image.outputs["Color"], n_out.inputs[1])
+    links.new(image.outputs["Color"], bump.inputs["Height"])
+    links.new(n_in.outputs["Strength"], bump.inputs["Strength"])
+    links.new(bump.outputs["Normal"], n_out.inputs[2])
+    group["enso_version"] = VERSION
+    return group
+
+
+class NODE_OT_enso_painted_strokes(Operator):
+    """Add Ensō Painted Strokes: a painted brush texture that breaks the edge of the cel """ \
+        """shadow into strokes. Connect its Threshold to the Threshold of Ensō Cel Bands"""
+    bl_idname = "node.enso_painted_strokes"
+    bl_label = "Ensō Painted Strokes"
+    bl_options = {'REGISTER', 'UNDO'}
+
+    @classmethod
+    def poll(cls, context):
+        space = context.space_data
+        return (space is not None and space.type == 'NODE_EDITOR' and space.tree_type == 'ShaderNodeTree'
+                and space.edit_tree is not None)
+
+    def invoke(self, context, event):
+        group = ensure_group()
+        if ensure_image() is None:
+            self.report({'WARNING'}, "The stroke texture was not found. Load a grey tiling image inside the group")
+        return bpy.ops.node.add_node(
+            'INVOKE_DEFAULT', type="ShaderNodeGroup", use_transform=True,
+            settings=[{"name": "node_tree", "value": "bpy.data.node_groups[%r]" % group.name}])
+
+    def execute(self, context):
+        group = ensure_group()
+        tree = context.space_data.edit_tree
+        node = tree.nodes.new("ShaderNodeGroup")
+        node.node_tree = group
+        node.location = context.space_data.cursor_location
+        for n in tree.nodes:
+            n.select = n == node
+        tree.nodes.active = node
+        return {'FINISHED'}
+
+
+classes = (
+    NODE_OT_enso_painted_strokes,
+)
