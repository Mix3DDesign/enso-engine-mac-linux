+def _poly_dist(px, py, pts):
+    """Signed distance to the edges of a convex polygon: positive inside."""
+    np = _np()
+    area = 0.0
+    n = len(pts)
+    for i in range(n):
+        x0, y0 = pts[i]
+        x1, y1 = pts[(i + 1) % n]
+        area += x0 * y1 - x1 * y0
+    sgn = 1.0 if area > 0 else -1.0
+    dist = None
+    for i in range(n):
+        x0, y0 = pts[i]
+        x1, y1 = pts[(i + 1) % n]
+        ex, ey = x1 - x0, y1 - y0
+        ln = max(math.hypot(ex, ey), 1e-9)
+        dd = sgn * (ex * (py - y0) - ey * (px - x0)) / ln
+        dist = dd if dist is None else np.minimum(dist, dd)
+    return dist
+
